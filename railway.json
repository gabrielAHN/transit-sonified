{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "src/**",
      "public/**",
      "index.html",
      "package.json",
      "package-lock.json",
      "vite.config.ts",
      "tsconfig.json",
      "components.json",
      "railway.json",
      "railpack.json",
      "Caddyfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
