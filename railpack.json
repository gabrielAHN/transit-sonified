{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22.12"
  },
  "steps": {
    "install": {
      "commands": ["npm ci --no-audit --no-fund"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npm run build"]
    }
  }
}
